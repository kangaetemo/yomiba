# Yomiba backend environment
# Copy to .env and adjust as needed. Real environment variables take precedence.

# Development uses a relative SQLite path. Production requires an absolute
# SQLite file path on persistent local storage (see PRODUCTION.md).
APP_ENV=development
DATABASE_URL=sqlite:///./yomiba.db
# Railway staging uses APP_ENV=staging, a mounted /data volume, and an explicit
# first-boot STAGING_DB_BOOTSTRAP=1. See RAILWAY_STAGING.md; do not use the
# local development DB for staging.

# Public URL of this API (informational / CORS hints)
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. Leave AUTH_COOKIE_SECURE=1 in HTTPS environments.
AUTH_COOKIE_SECURE=0
AUTH_SESSION_DAYS=30
# HMAC secret for the "trusted device" cookie that lets an account owner log
# in while a third party has rate-limited their email. Use a long random
# value in staging/production; if unset, a per-process random secret is used
# (device cookies then expire on every restart).
AUTH_DEVICE_SECRET=
# Startup takes an online SQLite backup before any pending Alembic migration
# (next to the DB file, *.pre-migration-*.bak). Disable only deliberately.
AUTO_MIGRATION_BACKUP=1

# Scraper behaviour
SCRAPER_TIMEOUT=20
# How many product detail pages a single search may additionally request
# (used to enrich results with ISBN / publisher / author / language).
SCRAPER_MAX_DETAIL_REQUESTS=15
# BKM paginated search limits (pagination stops at whichever is hit first).
BKM_SEARCH_PAGE_SIZE=20
BKM_MAX_SEARCH_PAGES=5
BKM_MAX_SEARCH_RESULTS=100
# Background price import policy. Search never starts an import.
# Recent successful imports are not immediately duplicated.
IMPORT_FRESHNESS_TTL_MINUTES=60
# Minimum gap between import attempts for the same query (anti-hammering).
IMPORT_FAILURE_RETRY_MINUTES=5
# Max concurrently running background import jobs.
IMPORT_MAX_CONCURRENT_JOBS=2
# Max jobs waiting for the fixed worker pool; scheduler dispatches as slots open.
IMPORT_QUEUE_CAPACITY=16
# Full CatalogSeries price refresh cycle; catalog sync has its own scheduler.
PRICE_REFRESH_ENABLED=1
PRICE_REFRESH_INTERVAL_HOURS=12
# After a restart the first refresh follows persisted freshness (catch-up
# when stale) but waits at least this settle delay.
PRICE_REFRESH_STARTUP_DELAY_MINUTES=10
# A store listing keeps its product unless another product is cheaper, the
# current one is out of stock, or unseen for this many hours.
LISTING_PRODUCT_SWITCH_HOURS=48
# How long a background import waits for its query's lock when a manual
# /import holds it (shared per-query import lock).
IMPORT_LOCK_TIMEOUT_SECONDS=120
# Scraper reliability: transient failures (network, 429/5xx) are retried
# with exponential backoff + jitter; bot walls fail fast.
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF_SECONDS=1.0
# Minimum gap between two HTTP requests of one scraper (per-store politeness).
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=0.5
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
SCRAPER_ACCEPT_LANGUAGE=tr-TR,tr;q=0.9,en;q=0.7

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
