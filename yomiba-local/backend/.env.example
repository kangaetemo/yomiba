# Yomiba backend environment
# Copy to .env and adjust as needed. Real environment variables take precedence.

# Storage. SQLite for development; use a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/yomiba
DATABASE_URL=sqlite:///./yomiba.db

# Public URL of this API (informational / CORS hints)
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scraper behaviour
SCRAPER_TIMEOUT=20
# How many product detail pages a single search may additionally request
# (used to enrich results with ISBN / publisher / author / language).
SCRAPER_MAX_DETAIL_REQUESTS=15
# BKM paginated search limits (pagination stops at whichever is hit first).
BKM_SEARCH_PAGE_SIZE=20
BKM_MAX_SEARCH_PAGES=5
BKM_MAX_SEARCH_RESULTS=100
# Automatic background import policy (DB-first search).
# Catalog data is "fresh" this long after the last successful import.
IMPORT_FRESHNESS_TTL_MINUTES=60
# Minimum gap between import attempts for the same query (anti-hammering).
IMPORT_FAILURE_RETRY_MINUTES=5
# Max concurrently running background import jobs.
IMPORT_MAX_CONCURRENT_JOBS=2
# How long a background import waits for its query's lock when a manual
# /import holds it (shared per-query import lock).
IMPORT_LOCK_TIMEOUT_SECONDS=120
# Scraper reliability: transient failures (network, 429/5xx) are retried
# with exponential backoff + jitter; bot walls fail fast.
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF_SECONDS=1.0
# Minimum gap between two HTTP requests of one scraper (per-store politeness).
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=0.5
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
SCRAPER_ACCEPT_LANGUAGE=tr-TR,tr;q=0.9,en;q=0.7

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
