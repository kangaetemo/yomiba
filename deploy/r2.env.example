# Copy to deploy/r2.env on the server (chmod 600). Never commit r2.env.
# Cloudflare dashboard -> R2 -> bucket "yomiba-yedek"; API token with
# "Object Read & Write" on that bucket only.
R2_BUCKET=yomiba-yedek
RCLONE_CONFIG_R2_ENDPOINT=https://<hesap-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
