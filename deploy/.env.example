# Copy to deploy/.env on the server and fill in. Never commit .env.

# --- Compose / Caddy ---
SITE_DOMAIN=yomiba.net
# Let's Encrypt expiry notices go here.
ACME_EMAIL=
# Host directory holding yomiba.db (+ -wal/-shm) and covers/. Owned by uid 10001.
DATA_DIR=/srv/yomiba/data

# --- Backend (APP_ENV and DATABASE_URL are set in docker-compose.yml) ---
SITE_URL=https://yomiba.net
BACKEND_URL=https://yomiba.net
CORS_ORIGINS=https://yomiba.net
AUTH_COOKIE_SECURE=1
# openssl rand -hex 32
AUTH_DEVICE_SECRET=

# Google sign-in (same web client id in both; add https://yomiba.net to the
# client's "Authorized JavaScript origins"). Changing the frontend value
# needs a rebuild: docker compose up -d --build frontend
GOOGLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Schedulers (defaults shown). Keep them 0 until the moved DB is verified.
CATALOG_SYNC_ENABLED=0
PRICE_REFRESH_ENABLED=0
CATALOG_SYNC_INTERVAL_HOURS=24
PRICE_REFRESH_INTERVAL_HOURS=12

# Stores blocked from Railway. Re-check from this host with
# `docker compose exec backend python outbound_smoke.py` before changing.
DISABLED_STORES=amazon,dr,cizman

# Price-alert mail over SMTP (e.g. Resend: smtp.resend.com, 465, ssl,
# user "resend", password = API key). Empty SMTP_HOST: mails stay queued.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Yomiba <bildirim@yomiba.net>

LOG_LEVEL=INFO
